{
  "info": {
    "name": "Job Application Portal API",
    "description": "Postman Collection for College Backend Project - Job Application Portal",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Candidate Register",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"candidate@example.com\",\n  \"password\": \"password123\"\n}"
        },
        "url": {
          "raw": "http://localhost:5001/api/auth/candidate/register",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5001",
          "path": ["api", "auth", "candidate", "register"]
        }
      }
    },
    {
      "name": "2. Candidate Login",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"candidate@example.com\",\n  \"password\": \"password123\"\n}"
        },
        "url": {
          "raw": "http://localhost:5001/api/auth/candidate/login",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5001",
          "path": ["api", "auth", "candidate", "login"]
        }
      }
    },
    {
      "name": "3. Recruiter Register",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Jane Smith (HR)\",\n  \"email\": \"recruiter@example.com\",\n  \"password\": \"password123\"\n}"
        },
        "url": {
          "raw": "http://localhost:5001/api/auth/recruiter/register",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5001",
          "path": ["api", "auth", "recruiter", "register"]
        }
      }
    },
    {
      "name": "4. Recruiter Login",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"recruiter@example.com\",\n  \"password\": \"password123\"\n}"
        },
        "url": {
          "raw": "http://localhost:5001/api/auth/recruiter/login",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5001",
          "path": ["api", "auth", "recruiter", "login"]
        }
      }
    },
    {
      "name": "5. Create Job (Recruiter Only)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{RECRUITER_JWT_TOKEN}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Backend Node.js Developer\",\n  \"description\": \"Looking for a beginner Node.js and Express developer with MongoDB knowledge.\",\n  \"company\": \"Tech Solutions Inc.\",\n  \"location\": \"Remote / Mumbai\"\n}"
        },
        "url": {
          "raw": "http://localhost:5001/api/jobs",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5001",
          "path": ["api", "jobs"]
        }
      }
    },
    {
      "name": "6. Get All Jobs",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{JWT_TOKEN}}" }
        ],
        "url": {
          "raw": "http://localhost:5001/api/jobs",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5001",
          "path": ["api", "jobs"]
        }
      }
    },
    {
      "name": "7. Get Job By ID",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{JWT_TOKEN}}" }
        ],
        "url": {
          "raw": "http://localhost:5001/api/jobs/{{JOB_ID}}",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5001",
          "path": ["api", "jobs", "{{JOB_ID}}"]
        }
      }
    },
    {
      "name": "8. Apply To Job (Candidate Only - PDF Upload)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{CANDIDATE_JWT_TOKEN}}" }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "resume",
              "type": "file",
              "description": "Upload a PDF resume file"
            }
          ]
        },
        "url": {
          "raw": "http://localhost:5001/api/jobs/{{JOB_ID}}/apply",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5001",
          "path": ["api", "jobs", "{{JOB_ID}}", "apply"]
        }
      }
    },
    {
      "name": "9. View Job Applicants (Job Owner Recruiter Only)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{RECRUITER_JWT_TOKEN}}" }
        ],
        "url": {
          "raw": "http://localhost:5001/api/jobs/{{JOB_ID}}/applicants",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5001",
          "path": ["api", "jobs", "{{JOB_ID}}", "applicants"]
        }
      }
    }
  ]
}
